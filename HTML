  const glowTex = (() => {
    const c = document.createElement('canvas'); c.width = c.height = 256;
    const g = c.getContext('2d'); const gr = g.createRadialGradient(128, 128, 0, 128, 128, 128);
    gr.addColorStop(0, 'rgba(255,90,110,0.55)'); gr.addColorStop(.45, 'rgba(227,24,55,0.18)'); gr.addColorStop(1, 'rgba(227,24,55,0)');
    g.fillStyle = gr; g.fillRect(0, 0, 256, 256); const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
  })();
  const glow = new THREE.Mesh(new THREE.PlaneGeometry(26, 14), new THREE.MeshBasicMaterial({ map: glowTex, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false }));
  glow.position.set(0, 2.6, -3.4);
  scene.add(glow);

  // --- feixe do projetor ---
  const apex = new THREE.Vector3(0, 4.6, 9.2);
  const screenCenter = new THREE.Vector3(0, 2.75, -2.8);
  const beamLen = apex.distanceTo(screenCenter);
  const beamGeo = new THREE.CylinderGeometry(0.06, 3.4, beamLen, 64, 1, true);
  beamGeo.translate(0, -beamLen / 2, 0);
  const beam = new THREE.Mesh(beamGeo, new THREE.ShaderMaterial({
    uniforms, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, side: THREE.DoubleSide,
    vertexShader: `varying vec2 vUv; varying float vRim;
      void main(){ vUv = uv; vec4 mv = modelViewMatrix*vec4(position,1.); vec3 n = normalize(normalMatrix*normal);
        vRim = abs(dot(n, normalize(-mv.xyz))); gl_Position = projectionMatrix*mv; }`,
    fragmentShader: `varying vec2 vUv; varying float vRim; uniform float uTime;
      float hash(float n){ return fract(sin(n)*43758.5453); }
      void main(){
        float along = vUv.y;
        float streak = .65 + .35*sin(vUv.x*60. + uTime*.4) * sin(vUv.x*23. - uTime*.25);
        float flick = .9 + .1*hash(floor(uTime*24.));
        float a = pow(vRim, 2.2) * (.05 + .1*along) * streak * flick;
        gl_FragColor = vec4(vec3(1.,.86,.8)*a, a);
      }`,
  }));
  beam.position.copy(apex);
  beam.quaternion.setFromUnitVectors(new THREE.Vector3(0, -1, 0), screenCenter.clone().sub(apex).normalize());
  scene.add(beam);

  // --- poeira dentro do feixe ---
  const COUNT = mobile ? 320 : 1100;
  const dust = new Float32Array(COUNT * 3); const seeds = new Float32Array(COUNT);
  const dir = screenCenter.clone().sub(apex);
  const side = new THREE.Vector3(1, 0, 0); const up = new THREE.Vector3().crossVectors(dir, side).normalize();
  for (let i = 0; i < COUNT; i++) {
    const t = Math.pow(Math.random(), .8) * .92 + .04;
    const r = 3.4 * t * Math.sqrt(Math.random()) * .9; const a = Math.random() * Math.PI * 2;
    const pt = apex.clone().addScaledVector(dir, t).addScaledVector(side, Math.cos(a) * r).addScaledVector(up, Math.sin(a) * r);
    dust.set([pt.x, pt.y, pt.z], i * 3); seeds[i] = Math.random();
  }
  const dustGeo = new THREE.BufferGeometry();
  dustGeo.setAttribute('position', new THREE.BufferAttribute(dust, 3));
  dustGeo.setAttribute('seed', new THREE.BufferAttribute(seeds, 1));
  const points = new THREE.Points(dustGeo, new THREE.ShaderMaterial({
    uniforms, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
    vertexShader: `attribute float seed; uniform float uTime; varying float vA;
      void main(){ vec3 p = position;
        p.x += sin(uTime*.12 + seed*40.)*.18; p.y += sin(uTime*.09 + seed*23.)*.22 + uTime*.015*(seed-.5);
        vec4 mv = modelViewMatrix*vec4(p,1.);
        vA = (.35 + .65*abs(sin(uTime*.7 + seed*60.))) * (.4 + seed*.6);
        gl_PointSize = (1.2 + seed*2.6) * (${(Math.min(devicePixelRatio || 1, mobile ? 1.5 : 2)).toFixed(2)}) * (9. / -mv.z);
        gl_Position = projectionMatrix*mv; }`,
    fragmentShader: `varying float vA; void main(){ float d = length(gl_PointCoord-.5); float a = smoothstep(.5,0.,d)*vA*.75; gl_FragColor = vec4(vec3(1.,.9,.82)*a, a); }`,
  }));
  scene.add(points);

  // --- fileiras de poltronas ---
  scene.add(new THREE.AmbientLight(0x2a1416, 0.9));
  const key = new THREE.DirectionalLight(0xff6a7e, 2.2); key.position.copy(screen.position); key.target.position.set(0, -1, 8); scene.add(key, key.target);
  const rim = new THREE.PointLight(0xffb48a, 18, 22, 2); rim.position.set(0, 2.5, -1); scene.add(rim);
  const seatGeo = new THREE.BoxGeometry(0.92, 0.95, 0.22); seatGeo.translate(0, 0.47, 0);
  const seatMat = new THREE.MeshStandardMaterial({ color: 0x1c1416, roughness: .55, metalness: .08 });
  const rows = [{ z: 3.4, y: -1.3 }, { z: 5.0, y: -0.9 }, { z: 6.6, y: -0.5 }, { z: 8.2, y: -0.1 }];
  const perRow = 17;
  const seats = new THREE.InstancedMesh(seatGeo, seatMat, rows.length * perRow);
  const m = new THREE.Matrix4(); const q = new THREE.Quaternion(); const s = new THREE.Vector3(1, 1, 1); let k = 0;
  rows.forEach((row, ri) => {
    for (let i = 0; i < perRow; i++) {
      const x = (i - (perRow - 1) / 2) * 1.05 + (ri % 2 ? .52 : 0);
      if (Math.abs(x) < 0.6 && ri > 1) { m.makeScale(0, 0, 0); seats.setMatrixAt(k++, m); continue; } // corredor
      const z = row.z + (x * x) / 34;
      q.setFromAxisAngle(new THREE.Vector3(0, 1, 0), -x / 34);
      m.compose(new THREE.Vector3(x, row.y, z), q, s); seats.setMatrixAt(k++, m);
    }
  });
  scene.add(seats);

  // --- luzes de degrau (detalhe de sala de cinema) ---
  const stepPts = []; rows.forEach((r) => { stepPts.push(-0.62, r.y + .02, r.z + .45, 0.62, r.y + .02, r.z + .45); });
  const stepGeo = new THREE.BufferGeometry(); stepGeo.setAttribute('position', new THREE.Float32BufferAttribute(stepPts, 3));
  scene.add(new THREE.Points(stepGeo, new THREE.PointsMaterial({ color: 0xff3a57, size: .09, transparent: true, opacity: .9, blending: THREE.AdditiveBlending, depthWrite: false })));

  // --- câmera, redimensionamento e ciclo ---
  const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
  addEventListener('pointermove', (e) => { pointer.tx = (e.clientX / innerWidth - .5) * 2; pointer.ty = (e.clientY / innerHeight - .5) * 2; }, { passive: true });
  function resize() {
    const w = hero.clientWidth, h = hero.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.fov = camera.aspect < .8 ? 66 : camera.aspect < 1.3 ? 54 : 42;
    target.y = camera.aspect < .8 ? -0.5 : 1.9;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(hero); resize();

  let running = true, visible = true, raf = 0, last = performance.now(), time = 3;
  function frame(now) {
    const dt = Math.min(.05, (now - last) / 1000); last = now; time += dt;
    uniforms.uTime.value = time;
    pointer.x += (pointer.tx - pointer.x) * .04; pointer.y += (pointer.ty - pointer.y) * .04;
    const prog = Math.min(1, Math.max(0, scrollY / (hero.clientHeight || 1)));
    camera.position.set(camBase.x + Math.sin(time * .11) * .28 + pointer.x * .55, camBase.y + Math.sin(time * .17) * .07 - pointer.y * .22 + prog * .4, camBase.z - prog * 2.2);
    camera.lookAt(target);
    const pulse = .82 + .18 * Math.sin(time * .9) * Math.sin(time * .37);
    key.intensity = 2.2 * pulse; rim.intensity = 18 * pulse; glow.material.opacity = .75 + .25 * pulse;
    renderer.render(scene, camera);
    if (!canvas.classList.contains('on')) canvas.classList.add('on');
    if (running && visible && !reduce) raf = requestAnimationFrame(frame);
  }
  const kick = () => { cancelAnimationFrame(raf); last = performance.now(); raf = requestAnimationFrame(frame); };
  new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (visible && !reduce) kick(); }, { threshold: 0 }).observe(hero);
  document.addEventListener('visibilitychange', () => { running = !document.hidden; if (running && visible && !reduce) kick(); });
  if (reduce) { new ResizeObserver(() => requestAnimationFrame(frame)).observe(hero); }
  kick();
}
</script>
</body>
