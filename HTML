<style>
/* Sala escura: a página é a própria sala — tela luminosa no alto, fileiras abaixo; cada plano é um ingresso destacável. */
:root {
  --ink: #090909;
  --graphite: #171717;
  --raised: #1f1d1e;
  --line: #2c292a;
  --paper: #ffffff;
  --muted: #b1abac;
  --dim: #8f8887;
  --red: #E31837;
  --red-hot: #ff3a57;
  --ember: #ffb48a;
  --ok: #3ddc97;
  --warn: #ffc857;
  --display: 'Manrope', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  --body: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --r-lg: 22px;
  --r-md: 14px;
  --r-sm: 10px;
  --gutter-l: max(20px, env(safe-area-inset-left, 0px));
  --gutter-r: max(20px, env(safe-area-inset-right, 0px));
  --ease: cubic-bezier(.2, .7, .1, 1);
  color-scheme: dark;
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--ink); color: var(--paper);
  font: 400 16px/1.65 var(--body); -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 60; background: var(--ink); }
img, svg, canvas { max-width: 100%; }
a { color: inherit; }
button { font: inherit; color: inherit; }
[hidden] { display: none !important; }
:focus-visible { outline: 2px solid var(--red-hot); outline-offset: 3px; border-radius: 6px; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--paper); color: var(--ink); padding: 10px 14px; border-radius: 8px; font-weight: 600; }
.skip:focus { top: calc(12px + env(safe-area-inset-top, 0px)); }

.wrap { width: 100%; max-width: 1220px; margin-inline: auto; padding-left: var(--gutter-l); padding-right: var(--gutter-r); }
.icon { width: 1.25em; height: 1.25em; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

/* ---------- tipografia ---------- */
h1, h2, h3 { font-family: var(--display); margin: 0; text-wrap: balance; }
h1 { font-weight: 800; font-size: clamp(2.6rem, 6.4vw, 5.6rem); line-height: .98; letter-spacing: -.035em; }
h2 { font-weight: 800; font-size: clamp(2rem, 4.2vw, 3.3rem); line-height: 1.04; letter-spacing: -.03em; }
h3 { font-weight: 700; font-size: 1.2rem; line-height: 1.25; letter-spacing: -.01em; }
p { margin: 0; }
.eyebrow { display: inline-flex; align-items: center; gap: .6em; font: 700 .74rem/1 var(--display); letter-spacing: .2em; text-transform: uppercase; color: var(--red-hot); }
.lead { color: var(--muted); font-size: clamp(1.02rem, 1.4vw, 1.18rem); max-width: 60ch; }
.sec { padding-block: clamp(80px, 11vw, 150px); position: relative; }
.sec-head { display: grid; gap: 18px; margin-bottom: clamp(36px, 5vw, 64px); max-width: 760px; }
.tag { display: inline-flex; align-items: center; gap: 6px; font: 600 .72rem/1 var(--body); letter-spacing: .04em; padding: 6px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); background: rgba(255,255,255,.03); }
.tag.warn { color: var(--warn); border-color: rgba(255,200,87,.35); background: rgba(255,200,87,.06); }

/* ---------- botões ---------- */
.btn { --bg: transparent; display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 24px; border-radius: 999px; border: 1px solid transparent; background: var(--bg); font: 700 .98rem/1 var(--display); letter-spacing: -.005em; text-decoration: none; cursor: pointer; transition: transform .35s var(--ease), background .3s, border-color .3s, box-shadow .35s; position: relative; overflow: hidden; isolation: isolate; }
.btn:hover { transform: translateY(-2px); }
.btn:active { transform: translateY(0) scale(.98); }
.btn.primary { --bg: var(--red); color: var(--paper); box-shadow: 0 10px 40px -12px rgba(227,24,55,.7), inset 0 1px 0 rgba(255,255,255,.18); }
.btn.primary:hover { --bg: var(--red-hot); box-shadow: 0 16px 50px -12px rgba(255,58,87,.85), inset 0 1px 0 rgba(255,255,255,.2); }
.btn.primary::after { content: ""; position: absolute; inset: -40% auto -40% -60%; width: 40%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.35), transparent); transform: skewX(-18deg); z-index: -1; transition: left .8s var(--ease); }
.btn.primary:hover::after { left: 130%; }
.btn.ghost { border-color: rgba(255,255,255,.22); color: var(--paper); background: rgba(255,255,255,.04); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
.btn.ghost:hover { border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.08); }
.btn.sm { min-height: 42px; padding: 0 18px; font-size: .9rem; }
.btn[disabled], .btn[aria-disabled="true"] { opacity: .55; cursor: not-allowed; transform: none; }

/* ---------- cabeçalho ---------- */
.hdr { position: fixed; z-index: 50; top: 0; left: 0; right: 0; padding-top: env(safe-area-inset-top, 0px); transition: background .4s, border-color .4s, backdrop-filter .4s; border-bottom: 1px solid transparent; }
.hdr.scrolled { background: rgba(9,9,9,.82); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); border-bottom-color: rgba(255,255,255,.06); }
.hdr-in { display: flex; align-items: center; gap: 24px; height: 76px; }
.hdr:has(.preview-bar:not([hidden])) ~ main .hero-inner { padding-top: 180px; }
.logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 800 1.25rem/1 var(--display); letter-spacing: .06em; }
.logo-mark { width: 34px; height: 26px; border: 2.4px solid var(--red); border-radius: 6px; position: relative; display: grid; place-items: center; box-shadow: 0 0 22px -4px rgba(227,24,55,.8); }
.logo-mark::before { content: ""; border-left: 8px solid var(--paper); border-top: 5px solid transparent; border-bottom: 5px solid transparent; margin-left: 2px; }
.logo-mark::after { content: ""; position: absolute; bottom: -7px; left: 7px; right: 7px; height: 2.4px; background: var(--paper); border-radius: 2px; }
.nav { display: flex; align-items: center; gap: 2px; margin-left: auto; }
.nav a { text-decoration: none; color: var(--muted); font: 500 .92rem/1 var(--body); padding: 10px 12px; border-radius: 999px; transition: color .25s, background .25s; white-space: nowrap; }
.nav a:hover { color: var(--paper); background: rgba(255,255,255,.06); }
.nav a.active { color: var(--paper); }
.nav a.active::after { content: ""; display: block; height: 2px; margin-top: 6px; border-radius: 2px; background: var(--red); }
.hdr-cta { margin-left: 8px; }
.menu-btn { display: none; margin-left: auto; width: 46px; height: 46px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255,255,255,.04); cursor: pointer; place-items: center; }
@media (max-width: 1080px) {
  .nav { position: absolute; top: 100%; left: 0; right: 0; max-height: calc(100dvh - 120px); overflow-y: auto; flex-direction: column; align-items: stretch; gap: 4px; padding: 14px var(--gutter-r) 22px var(--gutter-l); background: rgba(12,12,12,.97); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-bottom: 1px solid var(--line); transform: translateY(-12px); opacity: 0; visibility: hidden; transition: opacity .25s, transform .3s var(--ease), visibility .3s; margin: 0; }
  .nav.open { transform: none; opacity: 1; visibility: visible; }
  .nav a { padding: 15px 14px; font-size: 1.05rem; border-radius: 12px; }
  .nav a.active::after { display: none; }
  .nav a.active { background: rgba(255,255,255,.06); }
  .menu-btn { display: grid; }
  .hdr-cta { margin-left: 0; }
}
@media (max-width: 520px) { .hdr-cta { display: none; } .nav .nav-cta { display: flex; } }
.nav .nav-cta { display: none; margin-top: 8px; }

.preview-bar { position: relative; background: repeating-linear-gradient(-45deg, rgba(255,200,87,.1) 0 12px, rgba(255,200,87,.04) 12px 24px); border-bottom: 1px solid rgba(255,200,87,.25); color: var(--warn); font-size: .86rem; }
.preview-bar .wrap { display: flex; gap: 10px; align-items: center; padding-block: 7px; line-height: 1.35; }
.preview-bar .icon { width: 1.05em; height: 1.05em; }

/* ---------- hero ---------- */
.hero { position: relative; min-height: clamp(600px, 92svh, 900px); display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; }
.hero-fallback { position: absolute; inset: 0; z-index: -3; background:
  radial-gradient(60% 46% at 50% 26%, rgba(255,180,138,.32), transparent 70%),
  radial-gradient(80% 60% at 50% 30%, rgba(227,24,55,.38), transparent 72%),
  linear-gradient(180deg, #120709 0%, var(--ink) 78%); }
.hero-fallback::after { content: ""; position: absolute; left: 12%; right: 12%; top: 11%; height: 36%; border-radius: 6px; background: linear-gradient(120deg, #3a0a12, #e31837 40%, #ffb48a 55%, #4b0c16 80%); opacity: .45; filter: blur(2px); transform: perspective(900px) rotateX(4deg); }
#hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; opacity: 0; transition: opacity 1.6s ease; display: block; }
#hero-canvas.on { opacity: 1; }
.hero-shade { position: absolute; inset: 0; z-index: -1; pointer-events: none; background:
  linear-gradient(180deg, rgba(9,9,9,.55) 0%, rgba(9,9,9,0) 22%, rgba(9,9,9,0) 44%, rgba(9,9,9,.82) 76%, var(--ink) 100%),
  linear-gradient(90deg, rgba(9,9,9,.7) 0%, rgba(9,9,9,0) 58%); }
.hero-inner { padding-top: 140px; padding-bottom: clamp(56px, 8vw, 96px); display: grid; gap: 26px; }
.hero h1 { max-width: 12.5ch; }
.hero h1 .accent { color: var(--red-hot); }
.hero .lead { color: #d3cdce; }
.cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
.hero-facts { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; color: var(--muted); font-size: .9rem; }
.hero-facts li { display: inline-flex; align-items: center; gap: 8px; }
.hero-facts .icon { color: var(--red-hot); }
.rec { width: 8px; height: 8px; border-radius: 50%; background: var(--red-hot); box-shadow: 0 0 0 0 rgba(255,58,87,.7); animation: pulse 2.2s infinite; }
@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(255,58,87,.6); } 70% { box-shadow: 0 0 0 10px rgba(255,58,87,0); } 100% { box-shadow: 0 0 0 0 rgba(255,58,87,0); } }
.scroll-cue { position: absolute; right: var(--gutter-r); bottom: 36px; display: flex; align-items: center; gap: 10px; color: var(--dim); font: 600 .7rem/1 var(--display); letter-spacing: .22em; text-transform: uppercase; writing-mode: vertical-rl; text-decoration: none; }
.scroll-cue::after { content: ""; width: 1px; height: 54px; background: linear-gradient(var(--red), transparent); }
@media (max-width: 760px) { .scroll-cue { display: none; } }

/* ---------- revelação ao rolar (parte de um estado visível) ---------- */
.reveal { transition: transform .9s var(--ease), opacity .9s var(--ease); }
.js .reveal.pending { transform: translateY(26px); opacity: .35; }

/* ---------- conheça o aplicativo ---------- */
.feat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
@media (max-width: 980px) { .feat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .feat-grid { grid-template-columns: 1fr; } }
.feat { position: relative; display: grid; gap: 14px; align-content: start; padding: 26px; border-radius: var(--r-lg); background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.012)); border: 1px solid var(--line); overflow: hidden; transition: transform .5s var(--ease), border-color .4s, background .4s; min-width: 0; }
.feat::before { content: ""; position: absolute; inset: auto -30% -60% -30%; height: 80%; background: radial-gradient(closest-side, rgba(227,24,55,.28), transparent); opacity: 0; transition: opacity .5s; pointer-events: none; }
.feat:hover { transform: translateY(-6px); border-color: rgba(227,24,55,.45); }
.feat:hover::before { opacity: 1; }
.feat-art { height: 132px; border-radius: var(--r-md); position: relative; overflow: hidden; display: grid; place-items: center; background: radial-gradient(120% 90% at 50% 120%, rgba(227,24,55,.38), transparent 60%), linear-gradient(160deg, #1c1415, #0e0d0d); border: 1px solid rgba(255,255,255,.05); }
.feat-art::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(255,255,255,.025) 0 1px, transparent 1px 4px); }
.feat-art .icon { width: 56px; height: 56px; stroke-width: 1.3; color: var(--paper); filter: drop-shadow(0 0 18px rgba(255,58,87,.7)); transition: transform .6s var(--ease); }
.feat:hover .feat-art .icon { transform: scale(1.08) translateY(-3px); }
.feat-art .bars { position: absolute; left: 14px; right: 14px; bottom: 12px; display: flex; gap: 5px; }
.feat-art .bars span { flex: 1; height: 4px; border-radius: 2px; background: rgba(255,255,255,.1); }
.feat-art .bars span:nth-child(2) { background: var(--red); }
.feat p { color: var(--muted); font-size: .96rem; }

/* ---------- experiência / mockups ---------- */
.exp { overflow: hidden; background: linear-gradient(180deg, var(--ink), #0d0b0b 50%, var(--ink)); }
.filmstrip { position: absolute; left: 0; right: 0; height: 26px; opacity: .45; background:
  radial-gradient(circle at 50% 50%, var(--ink) 0 4.2px, transparent 4.8px) 0 0/22px 26px repeat-x, var(--graphite); }
.filmstrip.top { top: 0; } .filmstrip.bottom { bottom: 0; }
.exp-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(30px, 5vw, 72px); align-items: center; }
@media (max-width: 960px) { .exp-grid { grid-template-columns: 1fr; } }
.exp-list { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 14px; }
.exp-list li { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; padding: 16px 18px; border-radius: var(--r-md); border: 1px solid var(--line); background: rgba(255,255,255,.02); }
.exp-list .icon { color: var(--red-hot); margin-top: 3px; }
.exp-list strong { font-family: var(--display); display: block; margin-bottom: 2px; }
.exp-list span { color: var(--muted); font-size: .94rem; }
.stage { position: relative; perspective: 1700px; min-height: 460px; display: grid; place-items: center; }
.stage-floor { position: absolute; left: 6%; right: 6%; bottom: 8%; height: 40%; background: radial-gradient(50% 40% at 50% 60%, rgba(227,24,55,.32), transparent 70%); filter: blur(10px); }
.dev { position: absolute; transform-style: preserve-3d; transition: transform 1.2s var(--ease); }
.dev-screen { position: relative; overflow: hidden; background: #0b0b0c; }
.tv { width: min(92%, 640px); top: 6%; transform: rotateY(var(--ry, -10deg)) rotateX(4deg); }
.tv .bezel { padding: 10px; border-radius: 14px; background: linear-gradient(145deg, #2b2a2b, #0f0f10); box-shadow: 0 50px 90px -30px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.06), 0 0 80px -20px rgba(227,24,55,.45); }
.tv .dev-screen { aspect-ratio: 16 / 9; border-radius: 6px; }
.tv .foot { width: 34%; height: 46px; margin: 0 auto; background: linear-gradient(#1a1a1b, #0b0b0b); clip-path: polygon(38% 0, 62% 0, 100% 100%, 0 100%); }
.tablet { width: min(40%, 270px); right: 0; bottom: 4%; transform: rotateY(var(--ry2, -18deg)) rotateZ(2deg) translateZ(80px); }
.tablet .bezel { padding: 9px; border-radius: 20px; background: linear-gradient(145deg, #333, #121212); box-shadow: 0 40px 70px -24px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.08); }
.tablet .dev-screen { aspect-ratio: 4 / 3; border-radius: 12px; }
.phone { width: min(22%, 140px); left: 2%; bottom: 2%; transform: rotateY(var(--ry3, 16deg)) rotateZ(-4deg) translateZ(120px); }
.phone .bezel { padding: 7px; border-radius: 24px; background: linear-gradient(145deg, #333, #111); box-shadow: 0 40px 60px -20px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.08); }
.phone .dev-screen { aspect-ratio: 9 / 19; border-radius: 18px; }
.stage.settled .tv { --ry: -3deg; } .stage.settled .tablet { --ry2: -10deg; } .stage.settled .phone { --ry3: 8deg; }
@media (max-width: 600px) { .stage { min-height: 330px; } .tv { top: 4%; } .tablet { width: 44%; } .phone { width: 26%; } }
.exp-caption { margin-top: 18px; color: var(--dim); font-size: .82rem; display: flex; gap: 8px; align-items: center; }

/* interface demonstrativa dentro das telas */
.ui { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 1.1em; padding: 1.4em 1.6em 0; font-size: var(--fs, 9px); font-family: var(--display); color: var(--paper); }
.ui-top { display: flex; flex: none; align-items: center; gap: 1.6em; font-weight: 700; }
.ui-top .m { width: 1.7em; height: 1.25em; border: .2em solid var(--red); border-radius: .3em; }
.ui-top span { opacity: .55; } .ui-top span.on { opacity: 1; }
.ui-hero { position: relative; flex: none; border-radius: .6em; aspect-ratio: 16/5; overflow: hidden; font-size: var(--fs, 9px); background: linear-gradient(110deg, #2a070d 0%, #a3122a 38%, #ff9b6e 56%, #3b0a12 82%); }
.ui-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.65), transparent 70%); }
.ui-hero b { position: absolute; left: 6%; bottom: 18%; z-index: 1; font-size: 1.5em; letter-spacing: -.02em; }
.ui-hero i { position: absolute; left: 6%; bottom: 8%; z-index: 1; font-style: normal; font-size: .8em; opacity: .7; font-family: var(--body); }
.ui-row { display: grid; gap: .7em; align-content: start; }
.ui-row > em { font-style: normal; font-weight: 700; opacity: .8; }
.ui-tiles { display: grid; grid-template-columns: repeat(5, 1fr); gap: .6em; }
.ui-tiles > div { aspect-ratio: 16/10; border-radius: .4em; background: var(--g); box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); }
.ui-tiles.poster > div { aspect-ratio: 2/3; }
.ui-tiles > div.focus { outline: .18em solid var(--paper); outline-offset: .12em; }

/* ---------- como funciona ---------- */
.steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; position: relative; }
.steps::before { content: ""; position: absolute; left: 0; right: 0; top: 34px; height: 1px; background: var(--line); }
.steps::after { content: ""; position: absolute; left: 0; top: 34px; height: 1px; width: var(--fill, 0%); background: linear-gradient(90deg, var(--red), var(--red-hot)); transition: width 1.6s var(--ease); box-shadow: 0 0 12px rgba(255,58,87,.8); }
.step { position: relative; display: grid; gap: 12px; align-content: start; min-width: 0; }
.step-num { width: 68px; height: 68px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); border: 1px solid var(--line); font: 800 1.35rem/1 var(--display); color: var(--paper); position: relative; z-index: 1; transition: border-color .5s, box-shadow .5s; }
.step.lit .step-num { border-color: var(--red); box-shadow: 0 0 30px -6px rgba(227,24,55,.8); }
.step .icon { color: var(--red-hot); width: 22px; height: 22px; }
.step p { color: var(--muted); font-size: .95rem; }
@media (max-width: 900px) {
  .steps { grid-template-columns: 1fr; gap: 26px; }
  .steps::before, .steps::after { left: 34px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
  .steps::after { height: var(--fill, 0%); bottom: auto; }
  .step { grid-template-columns: 68px 1fr; column-gap: 18px; }
  .step-num { grid-row: span 3; }
}
.notice { margin-top: 34px; display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; border-radius: var(--r-md); border: 1px solid rgba(255,200,87,.25); background: rgba(255,200,87,.05); color: #eadfc6; font-size: .94rem; }
.notice .icon { color: var(--warn); margin-top: 2px; }

/* ---------- planos (ingressos) ---------- */
.plans-sec { background: radial-gradient(70% 50% at 50% 0%, rgba(227,24,55,.12), transparent 70%), var(--ink); }
.plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 520px), 1fr)); gap: 22px; }
.ticket { --notch: 14px; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 210px; border-radius: var(--r-lg); background: linear-gradient(160deg, #1d1b1c, #131213); border: 1px solid var(--line); transition: transform .5s var(--ease), box-shadow .5s, border-color .4s; min-width: 0; }
.ticket:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgba(0,0,0,.9); }
.ticket.hi { border-color: rgba(227,24,55,.6); box-shadow: 0 0 0 1px rgba(227,24,55,.25), 0 30px 80px -30px rgba(227,24,55,.55); }
.ticket.hi::before { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; background: conic-gradient(from var(--a, 0deg), transparent 0 70%, var(--red-hot) 82%, transparent 92%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; animation: spin 6s linear infinite; pointer-events: none; }
@property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
@keyframes spin { to { --a: 360deg; } }
.t-main { padding: 28px; display: grid; gap: 14px; align-content: start; min-width: 0; }
.t-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; justify-content: space-between; }
.t-kicker { font: 700 .7rem/1 var(--display); letter-spacing: .2em; text-transform: uppercase; color: var(--dim); }
.t-badge { font: 700 .72rem/1 var(--display); letter-spacing: .08em; text-transform: uppercase; padding: 7px 10px; border-radius: 999px; background: var(--red); color: var(--paper); }
.t-badge.demo { background: rgba(255,200,87,.12); color: var(--warn); border: 1px solid rgba(255,200,87,.35); }
.t-main h3 { font-size: 1.6rem; letter-spacing: -.02em; }
.t-desc { color: var(--muted); font-size: .96rem; }
.t-feats { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 9px; }
.t-feats li { display: flex; gap: 10px; align-items: flex-start; font-size: .95rem; }
.t-feats .icon { color: var(--red-hot); margin-top: 3px; width: 1.05em; height: 1.05em; }
.t-limits { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: .88rem; border-top: 1px dashed var(--line); padding-top: 14px; margin-top: 4px; }
.t-stub { position: relative; padding: 28px 24px; display: grid; gap: 14px; align-content: space-between; border-left: 2px dashed rgba(255,255,255,.12); background: linear-gradient(180deg, rgba(227,24,55,.08), transparent 70%); border-radius: 0 var(--r-lg) var(--r-lg) 0; }
.t-stub::before, .t-stub::after { content: ""; position: absolute; left: calc(var(--notch) * -1 - 1px); width: calc(var(--notch) * 2); height: calc(var(--notch) * 2); border-radius: 50%; background: var(--ink); border: 1px solid var(--line); }
.t-stub::before { top: calc(var(--notch) * -1 - 1px); clip-path: inset(50% 0 0 0); }
.t-stub::after { bottom: calc(var(--notch) * -1 - 1px); clip-path: inset(0 0 50% 0); }
.ticket.hi .t-stub::before, .ticket.hi .t-stub::after { border-color: rgba(227,24,55,.6); }
.t-price { display: grid; gap: 4px; }
.t-price small { color: var(--dim); font: 600 .72rem/1 var(--display); letter-spacing: .16em; text-transform: uppercase; }
.t-price strong { font: 800 2.3rem/1 var(--display); letter-spacing: -.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }
.t-price strong.tbd { font-size: 1.3rem; color: var(--muted); }
.t-price span { color: var(--muted); font-size: .84rem; }
.t-meta { display: grid; gap: 6px; font-size: .84rem; color: var(--muted); }
.t-meta div { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px solid rgba(255,255,255,.06); padding-bottom: 6px; }
.t-meta b { color: var(--paper); font-weight: 600; font-variant-numeric: tabular-nums; }
.t-stub .btn { width: 100%; }
@media (max-width: 640px) {
  .ticket { grid-template-columns: 1fr; }
  .t-stub { border-left: 0; border-top: 2px dashed rgba(255,255,255,.12); border-radius: 0 0 var(--r-lg) var(--r-lg); }
  .t-stub::before { left: calc(var(--notch) * -1 - 1px); top: calc(var(--notch) * -1 - 1px); clip-path: inset(0 0 0 50%); }
  .t-stub::after { left: auto; right: calc(var(--notch) * -1 - 1px); top: calc(var(--notch) * -1 - 1px); bottom: auto; clip-path: inset(0 50% 0 0); }
}
.empty { padding: 36px; border-radius: var(--r-lg); border: 1px dashed var(--line); color: var(--muted); display: grid; gap: 10px; justify-items: start; }
.plans-foot { margin-top: 26px; display: flex; flex-wrap: wrap; gap: 10px 26px; color: var(--muted); font-size: .9rem; }
.plans-foot span { display: inline-flex; gap: 8px; align-items: center; }
.plans-foot .icon { color: var(--red-hot); }

/* ---------- compatibilidade ---------- */
.compat { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 14px; }
.compat-item { display: grid; gap: 10px; padding: 22px; border-radius: var(--r-md); border: 1px solid var(--line); background: rgba(255,255,255,.02); }
.compat-item .icon { width: 34px; height: 34px; color: var(--paper); stroke-width: 1.4; }
.compat-item p { color: var(--muted); font-size: .9rem; }

/* ---------- suporte ---------- */
.support-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
.sup { grid-column: span 2; display: grid; gap: 12px; align-content: start; padding: 24px; border-radius: var(--r-lg); background: var(--graphite); border: 1px solid var(--line); min-width: 0; }
.sup.wide { grid-column: span 3; }
.sup .icon { width: 26px; height: 26px; color: var(--red-hot); }
.sup p { color: var(--muted); font-size: .95rem; }
.sup .contact-lines { display: grid; gap: 8px; }
.sup .contact-lines a, .sup .contact-lines span { display: inline-flex; gap: 8px; align-items: center; font-weight: 600; text-decoration: none; word-break: break-word; }
.sup .contact-lines a:hover { color: var(--red-hot); }
.linkbtn { background: none; border: 0; padding: 0; color: var(--paper); font-weight: 600; text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; cursor: pointer; justify-self: start; }
@media (max-width: 900px) { .sup, .sup.wide { grid-column: span 3; } }
@media (max-width: 600px) { .support-grid { grid-template-columns: 1fr; } .sup, .sup.wide { grid-column: auto; } }

/* ---------- FAQ ---------- */
.faq-wrap { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(30px, 5vw, 80px); align-items: start; }
@media (max-width: 900px) { .faq-wrap { grid-template-columns: 1fr; } }
.faq-wrap .sec-head { position: sticky; top: 110px; margin-bottom: 0; }
@media (max-width: 900px) { .faq-wrap .sec-head { position: static; } }
.faq { display: grid; gap: 10px; }
.faq details { border: 1px solid var(--line); border-radius: var(--r-md); background: rgba(255,255,255,.02); transition: border-color .3s, background .3s; }
.faq details[open] { border-color: rgba(227,24,55,.45); background: rgba(227,24,55,.04); }
.faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 20px 22px; font: 700 1.04rem/1.35 var(--display); }
.faq summary::-webkit-details-marker { display: none; }
.faq summary .pm { width: 28px; height: 28px; flex: none; border-radius: 50%; border: 1px solid var(--line); position: relative; transition: transform .35s var(--ease), border-color .3s; }
.faq summary .pm::before, .faq summary .pm::after { content: ""; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.6px; background: var(--paper); transform: translate(-50%, -50%); }
.faq summary .pm::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .35s var(--ease); }
.faq details[open] .pm { border-color: var(--red); transform: rotate(180deg); }
.faq details[open] .pm::after { transform: translate(-50%, -50%) rotate(0deg); }
.faq .ans { padding: 0 22px 22px; color: var(--muted); max-width: 66ch; white-space: pre-line; }

/* ---------- CTA final ---------- */
.final { padding-block: clamp(90px, 12vw, 160px); position: relative; overflow: hidden; text-align: left; }
.final::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1100px, 120%); aspect-ratio: 2.4; transform: translate(-50%, -30%); background: radial-gradient(50% 50% at 50% 50%, rgba(227,24,55,.35), transparent 70%); filter: blur(20px); pointer-events: none; }
.final .wrap { position: relative; display: grid; gap: 26px; justify-items: start; }
.final h2 { font-size: clamp(2.2rem, 5.4vw, 4.4rem); max-width: 16ch; }

/* ---------- rodapé ---------- */
.ftr { border-top: 1px solid var(--line); background: #0b0a0a; padding-block: 56px 36px; color: var(--muted); font-size: .92rem; }
.ftr-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 36px; }
@media (max-width: 860px) { .ftr-grid { grid-template-columns: 1fr; } }
.ftr h3 { font-size: .78rem; letter-spacing: .18em; text-transform: uppercase; color: var(--paper); margin-bottom: 14px; }
.ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.ftr .linkbtn { color: var(--muted); text-decoration: none; font-weight: 500; }
.ftr .linkbtn:hover { color: var(--paper); }
.ftr-bottom { margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: space-between; font-size: .84rem; color: var(--dim); }

/* ---------- diálogos ---------- */
dialog { border: 0; padding: 0; background: transparent; color: var(--paper); max-width: min(620px, calc(100vw - 24px)); width: 100%; max-height: calc(100dvh - 24px); }
dialog::backdrop { background: rgba(5,5,5,.72); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
dialog[open] .dlg { animation: dlg-in .45s var(--ease); }
@keyframes dlg-in { from { transform: translateY(24px) scale(.98); opacity: 0; } }
.dlg { background: #141313; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: auto; max-height: calc(100dvh - 24px); box-shadow: 0 40px 120px -30px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.03); }
.dlg-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 20px 22px; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: #141313; z-index: 1; }
.dlg-head h2 { font-size: 1.25rem; letter-spacing: -.01em; }
.x { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: transparent; cursor: pointer; display: grid; place-items: center; }
.x:hover { background: rgba(255,255,255,.06); }
.dlg-body { padding: 22px; display: grid; gap: 20px; }
.summary { border-radius: var(--r-md); border: 1px solid var(--line); overflow: hidden; }
.summary-top { padding: 18px; display: grid; gap: 6px; background: linear-gradient(120deg, rgba(227,24,55,.18), transparent 70%); border-bottom: 2px dashed rgba(255,255,255,.1); }
.summary-top h3 { font-size: 1.3rem; }
.summary dl { margin: 0; padding: 14px 18px; display: grid; gap: 8px; font-size: .92rem; }
.summary dl div { display: flex; justify-content: space-between; gap: 16px; }
.summary dt { color: var(--muted); }
.summary dd { margin: 0; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
.summary .total { padding: 14px 18px; display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--line); }
.summary .total strong { font: 800 1.7rem/1 var(--display); font-variant-numeric: tabular-nums; }
.conds { font-size: .86rem; color: var(--muted); display: grid; gap: 8px; }
.conds li { margin-left: 18px; }
.form { display: grid; gap: 14px; }
.field { display: grid; gap: 6px; }
.field label { font: 600 .86rem/1.2 var(--body); }
.field label small { color: var(--dim); font-weight: 400; }
.field input { width: 100%; min-height: 50px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--line); background: #0d0c0c; color: var(--paper); font: 400 1rem var(--body); transition: border-color .2s, box-shadow .2s; }
.field input:focus { outline: none; border-color: var(--red-hot); box-shadow: 0 0 0 3px rgba(255,58,87,.22); }
.field input[aria-invalid="true"] { border-color: var(--red-hot); }
.err { color: #ff8095; font-size: .82rem; min-height: 0; }
.check { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: start; font-size: .9rem; color: #ddd6d7; }
.check input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--red); }
.hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
.form-msg { padding: 12px 14px; border-radius: 12px; font-size: .9rem; border: 1px solid rgba(255,58,87,.4); background: rgba(255,58,87,.08); color: #ffd0d7; }
.form-msg.info { border-color: rgba(255,200,87,.35); background: rgba(255,200,87,.06); color: #eadfc6; }
.secure { display: flex; gap: 8px; align-items: center; font-size: .82rem; color: var(--dim); }
.spinner { width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(255,255,255,.35); border-top-color: var(--paper); animation: rot .8s linear infinite; }
@keyframes rot { to { transform: rotate(360deg); } }
.legal-text { white-space: pre-line; color: #ddd6d7; font-size: .95rem; max-width: 70ch; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; scroll-behavior: auto !important; }
  .js .reveal.pending { transform: none; opacity: 1; }
}
</style>
